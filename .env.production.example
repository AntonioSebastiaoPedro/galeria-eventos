# Na VPS: cp .env.production.example .env  e preencher. NUNCA fazer commit do preenchido.
# Nome do projecto no Docker: separa contentores e volumes dos de outros projectos na mesma VPS
COMPOSE_PROJECT_NAME=galeria
HTTP_PORT=29680
POSTGRES_VERSION=17
DB_DATABASE=galeria_eventos
DB_USERNAME=galeria
DB_PASSWORD=          # longa e aleatória

APP_NAME="Galeria de Eventos"
APP_ENV=production
APP_DEBUG=false
# Para cifrar os backups (scripts/backup.sh) com o age: chave pública do destinatário.
# BACKUP_AGE_RECIPIENT=
APP_KEY=              # base64:$(openssl rand -base64 32)
APP_URL=https://galeria.shopall.ao
# Origem do frontend: as ligações dos e-mails e dos QR Codes apontam para aqui (a API não serve páginas)
FRONTEND_URL=https://galeria.shopall.ao
APP_TIMEZONE=Africa/Luanda
APP_LOCALE=pt_AO
APP_FALLBACK_LOCALE=pt
SANCTUM_STATEFUL_DOMAINS=galeria.shopall.ao
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=20160

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=galeria
REVERB_APP_KEY=galeria-key  # é público e vai embutido no frontend (echo.ts); manter
REVERB_APP_SECRET=    # aleatória
REVERB_HOST=galeria.shopall.ao
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http

MAIL_MAILER=resend
# Chave em https://resend.com/api-keys; o domínio do remetente tem de estar verificado no Resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=galeria@shopall.ao
MAIL_FROM_NAME="${APP_NAME}"

MEDIA_PHOTO_MAX_MB=25
MEDIA_VIDEO_MAX_MB=300
# O nginx envia as fotografias e os vídeos depois de o PHP os autorizar (precisa do volume no nginx do compose.prod.yml)
MEDIA_X_ACCEL=true
FREE_EVENTS_PER_USER=1

# Pagamento da mudança de plano (Multicaixa Express) e contacto de apoio (WhatsApp)
PAYMENT_EXPRESS_NUMBER=
PAYMENT_EXPRESS_HOLDER=
PAYMENT_PROOF_MAX_MB=10
SUPPORT_PHONE=
