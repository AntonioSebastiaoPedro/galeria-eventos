# Portas expostas no host (não convencionais e diferentes das do unia-presence, para evitar conflitos)
HTTP_PORT=29680
HTTPS_PORT=29643
DB_HOST_PORT=25639
REDIS_HOST_PORT=26589
REVERB_HOST_PORT=29685
VITE_HOST_PORT=25373
MAILPIT_SMTP_PORT=21225
MAILPIT_UI_PORT=29125

POSTGRES_VERSION=17
DB_DATABASE=galeria_eventos
DB_USERNAME=galeria
DB_PASSWORD=change-me

# Laravel
APP_NAME="Galeria de Eventos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Telescope (/telescope, só superadmin). Em produção só regista exceções e jobs falhados.
TELESCOPE_ENABLED=true
APP_URL=http://localhost:29680
FRONTEND_URL=http://localhost:25373
APP_TIMEZONE=Africa/Luanda
APP_LOCALE=pt_AO
APP_FALLBACK_LOCALE=pt
SANCTUM_STATEFUL_DOMAINS=localhost:29680,localhost:25373

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Os convidados ficam identificados pela sessão: dura o tempo de uma festa e mais uns dias (em minutos).
SESSION_LIFETIME=20160

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=galeria
REVERB_APP_KEY=galeria-key
REVERB_APP_SECRET=galeria-secret
REVERB_HOST=localhost
REVERB_PORT=29680
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=galeria@galeria.local
MAIL_FROM_NAME="${APP_NAME}"
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http

# Limites dos ficheiros (MB). Os limites de armazenamento de cada plano estão em config/plans.php.
MEDIA_PHOTO_MAX_MB=25
MEDIA_VIDEO_MAX_MB=300
# Quantos eventos no plano gratuito cada organizador pode ter ao mesmo tempo
FREE_EVENTS_PER_USER=1

# uid/gid do utilizador do host (desenvolvimento), para o PHP poder escrever em backend/storage
HOST_UID=1000
HOST_GID=1000

# Pagamento da mudança de plano (Multicaixa Express) e contacto de apoio (WhatsApp)
PAYMENT_EXPRESS_NUMBER=923000000
PAYMENT_EXPRESS_HOLDER="Galeria de Eventos (demonstração)"
PAYMENT_PROOF_MAX_MB=10
SUPPORT_PHONE=923000000
